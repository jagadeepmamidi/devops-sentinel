{
  "$schema": "https://vercel.com/docs/project-configuration.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/demo/:path*", "destination": "/api/demo/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/demo/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "functions": {
    "api/demo/[...path].js": {
      "includeFiles": "demo-api.mjs"
    }
  }
}

